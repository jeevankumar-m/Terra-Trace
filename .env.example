# Frontend: where the browser reaches the API (use 127.0.0.1, not localhost: avoids a 2 s IPv6 fallback on Windows)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# API: data root (default ./data) and allowed CORS origins
TERRATRACE_DATA=./data
TERRATRACE_CORS=http://localhost:3000,http://127.0.0.1:3000
# Not needed today: the NASA sample GCOV files are public. If ASF/Earthdata downloads are added later,
# put credentials here (never commit .env):
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
